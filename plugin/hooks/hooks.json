{
  "description": "Always ask the user before a cc-move command that changes something (migrate, undo, archive, relink), in every permission mode",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*cc_move.py*)",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/confirm_changes.py\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(*cc_move.py*)",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/confirm_changes.py\""
          }
        ]
      }
    ]
  }
}
